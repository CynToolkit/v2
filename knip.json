{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["assets/*", "apps/mini-c3-electron"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/setup/*.mjs",
        "supabase/tests/*.mjs",
        "supabase/functions/*/index.ts",
        "supabase/functions/**/*.test.ts"
      ]
    },
    "apps/ui": {
      "entry": ["tests/browser/*.cjs"]
    },
    "apps/cli": {
      "entry": ["tests/e2e/**/*.spec.ts"]
    },
    "workers": {
      "entry": ["pipelab-cloud/index.ts", "local-r2/worker.ts", "scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": ["electron-builder.config.mjs"],
      "ignoreDependencies": ["@napi-rs/keyring"]
    },
    "packages/providers": {
      "entry": [".construct-benchmark.ts"]
    },
    "packages/workflow-runtime": {
      "entry": ["src/phase-types.typecheck.ts"]
    }
  },
  "ignore": ["apps/website/src/database.types.ts"],
  "ignoreIssues": {
    "packages/providers/src/*/index.ts": ["duplicates"]
  },
  "ignoreDependencies": ["@pipelab/tsconfig"],
  "ignoreBinaries": ["tsx", "supabase", "doppler", "taskkill.exe"]
}
