{
  "name": "@pipelab/app",
  "version": "2.0.0-beta.42",
  "private": true,
  "description": "-",
  "homepage": "https://pipelab.app",
  "license": "FSL-1.1-MIT",
  "author": "Armaldio",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/v2.git",
    "directory": "apps/desktop"
  },
  "files": [
    "assets/build",
    "src",
    "electron-builder.config.mjs",
    "desktop-env.d.ts",
    "tsconfig.json",
    "vite.base.config.mts",
    "vite.main.config.mts",
    "vite.preload.config.mts"
  ],
  "main": ".vite/build/main.js",
  "scripts": {
    "build:vite": "vite build -c vite.main.config.mts && vite build -c vite.preload.config.mts",
    "dev": "cross-env NODE_OPTIONS=--enable-source-maps pnpm build:vite && electron .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "make": "node scripts/package-deployed.mjs",
    "make-dev-prerelease": "pnpm version prerelease --preid=dev",
    "package": "node scripts/package-deployed.mjs --dir",
    "smoke:electron:manual": "node scripts/electron-smoke-test.mjs",
    "start": "pnpm build:vite && electron .",
    "start:args": "pnpm build:vite && electron . --project ./tests/e2e/fixtures/folder-to-electron.json --action run",
    "test": "vitest run",
    "test:local-release-e2e": "node scripts/electron-local-release-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@pipelab/constants": "workspace:*",
    "@pipelab/core-node": "workspace:*",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/shared": "workspace:*",
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "@types/semver": "7.7.1",
    "cross-env": "10.1.0",
    "electron": "39.8.10",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "posthog-node": "6.0.2",
    "semver": "7.8.0",
    "tsx": "4.19.1",
    "typescript": "5.8.3",
    "vite": "6.3.3",
    "vitest": "3.1.4"
  }
}
