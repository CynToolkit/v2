{
  "name": "@pipelab/providers",
  "version": "1.0.0-beta.2",
  "private": true,
  "description": "Built-in Release and Workflow providers shipped with Pipelab",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/v2.git",
    "directory": "packages/providers"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./metadata": {
      "types": "./src/metadata.ts",
      "import": "./src/metadata.ts",
      "default": "./src/metadata.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:construct": "vitest run src/construct",
    "test:electron": "vitest run src/electron",
    "test:godot": "vitest run src/godot",
    "test:tauri": "vitest run src/tauri",
    "test:steam": "vitest run src/steam",
    "test:itch": "vitest run src/itch",
    "test:poki": "vitest run src/poki"
  },
  "dependencies": {
    "@pipelab/constants": "workspace:*",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/shared": "workspace:*",
    "@pipelab/workflow-runtime": "workspace:*",
    "adm-zip": "0.6.1",
    "change-case": "5.4.4",
    "confbox": "0.3.2",
    "execa": "10.2.1",
    "node-stream-zip": "1.15.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@pipelab/test-utils": "workspace:*",
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "^24.12.2",
    "@types/proper-lockfile": "4.1.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
