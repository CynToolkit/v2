{
  "name": "@pipelab/workflow-runtime",
  "version": "1.0.0-beta.2",
  "private": true,
  "description": "Standalone workflow execution runtime for Pipelab",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CynToolkit/v2.git",
    "directory": "packages/workflow-runtime"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./task-ids": {
      "types": "./task-ids.d.ts",
      "import": "./src/tasks/task-ids.ts",
      "default": "./src/tasks/task-ids.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
