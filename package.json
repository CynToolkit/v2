{
  "name": "pipelab-monorepo",
  "private": true,
  "license": "FSL-1.1-MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev-remote": "turbo dev:remote",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "package": "pnpm --filter @pipelab/app package",
    "make": "pnpm --filter @pipelab/app make",
    "changeset": "changeset",
    "version-packages": "pnpm changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
    "supa:types": "supabase gen types typescript --remote=$SUPABASE_PROJECT_ID > packages/shared/src/database.types.ts",
    "pipelab": "node scripts/pipelab-dev.mjs",
    "docs": "pnpm --filter @pipelab/documentation dev",
    "docs:build": "pnpm --filter @pipelab/documentation build",
    "docs:preview": "pnpm --filter @pipelab/documentation preview",
    "prepare": "husky",
    "release": "pnpm exec turbo build --filter=@pipelab/cli... --concurrency=2 && pnpm --filter @pipelab/cli exec npm pack ./dist --dry-run && pnpm changeset publish",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3.0.3",
    "@pipelab/plugin-core": "workspace:*",
    "@pipelab/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "knip": "6.46.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "playwright": "1.62.1",
    "turbo": "^2.8.15",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "resolutions": {
    "@codemirror/state": "6.4.1",
    "vue-demi": "0.14.10"
  },
  "packageManager": "pnpm@10.33.0"
}
